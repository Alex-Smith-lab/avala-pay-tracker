{
  "manifest_version": 3,
  "name": "Avala Batch Payment Report",
  "version": "1.0.0",
  "description": "Automatically tracks Avala upcoming payment batches and totals by delivery age.",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://pay.avala.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pay.avala.ai/dashboard*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Avala Batch Report"
  }
}
