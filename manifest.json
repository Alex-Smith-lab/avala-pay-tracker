
{
  "manifest_version": 3,
  "name": "Avala Pay Tracker",
  "version": "1.1.0",
  "description": "Track upcoming Avala payments, batch ages, and totals.",
  "permissions": [
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://pay.avala.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Avala Pay Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pay.avala.ai/dashboard*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
